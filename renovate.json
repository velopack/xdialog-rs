{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly",
    ":semanticCommitsDisabled"
  ],
  "labels": ["renovate"],
  "schedule": ["on saturday before 11am"],
  "timezone": "Europe/London",
  "minimumReleaseAge": "14 days",
  "dependencyDashboard": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"],
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "automerge": true,
      "matchDatasources": "crate"
    },
    {
      "groupName": "windows crates",
      "matchPackageNames": ["windows", "windows-numerics", "widestring"]
    },
    {
      "description": "windows 0.62 APIs take windows-numerics 0.3 types; lift this once a windows 0.100 release exists.",
      "matchPackageNames": ["windows-numerics"],
      "allowedVersions": "<0.100"
    },
    {
      "groupName": "linux crates",
      "matchPackageNames": ["gtk", "glib"]
    },
    {
      "groupName": "fltk crates",
      "matchPackageNames": ["fltk", "font-kit", "mina", "enum-map"]
    },
    {
      "groupName": "macos crates",
      "matchPackageNames": [
        "objc2",
        "objc2-foundation",
        "objc2-app-kit",
        "block2"
      ]
    }
  ]
}
